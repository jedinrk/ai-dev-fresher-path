PORT=3000
NODE_ENV=development

# DigitalOcean API token, used by doctl for deployment. Never commit the real value.
DIGITALOCEAN_ACCESS_TOKEN=

# Comma-separated list of emails allowed to register/log in.
ALLOWLIST_EMAILS=

# The one allowlisted email that gets the mentor/admin role.
MENTOR_EMAIL=

# Used to sign the session cookie. Generate your own, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Path to the SQLite database file.
DB_PATH=./data/app.db
